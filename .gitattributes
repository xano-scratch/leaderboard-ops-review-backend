# XanoScript is generated (see xanoscript/README.md), but it is the review
# surface for a backend change: the diff here is what the engine will run.
#
# Deliberately NOT linguist-generated. That attribute is the one linguist
# option that COLLAPSES a file in pull request diffs, which would hide the
# very thing this directory is committed for. linguist-vendored drops it from
# the repository language bar and leaves the diff expanded.
xanoscript/**       linguist-vendored=true

# GitHub's built-in ".xs" language is Perl XS (tm_scope: source.c), so without
# this every XanoScript file renders with C syntax highlighting and counts as
# Perl XS in the language bar. HCL is the closest built-in match to
# XanoScript's `block name { key = value }` grammar with // comments.
*.xs                linguist-language=HCL

# The committed rendering must be byte-identical to what `xanots export`
# produces, on every checkout. Without this, one contributor with
# core.autocrlf=true makes the drift check fail on every file.
*.xs                text eol=lf
*.ts                text eol=lf
*.tsx               text eol=lf
xano/xano.lock      text eol=lf

# package-lock.json is already auto-detected as generated by linguist; no
# override needed here.
